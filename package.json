{
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "prod-client": "npm --prefix client run build --silent",
    "prod-server": "npm --prefix server run start --silent",
    "prod": "concurrently \"npm run prod-server --silent\" \"npm run prod-client --silent\"",
    "dev-client": "npm --prefix client run dev --silent",
    "dev-server": "npm --prefix server run dev --silent",
    "dev": "concurrently \"npm run dev-server --silent\" \"npm run dev-client --silent\"",
    "start-dev": "npm install --silent cross-env && cross-env MODE=dev node start.js dev",
    "start-prod": "npm install --silent cross-env && cross-env MODE=prod node start.js prod"
  },
  "name": "sigmatokens",
  "version": "1.0.0",
  "description": "**Add stuff here later on**",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SigmaTokens/SigmaTokens.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SigmaTokens/SigmaTokens/issues"
  },
  "homepage": "https://github.com/SigmaTokens/SigmaTokens#readme",
  "devDependencies": {
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.5",
    "prettier": "^3.5.3",
    "prettier-plugin-embed": "^0.5.0",
    "prettier-plugin-sql": "^0.19.0",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "dependencies": {
    "@types/node": "^22.14.1",
    "chart.js": "^4.4.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "ip": "^2.0.1",
    "ping": "^0.4.4",
    "react-chartjs-2": "^5.3.0",
    "recharts": "^2.1.9",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  }
}
