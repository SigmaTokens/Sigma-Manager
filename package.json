{
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "prod-client": "npm --prefix client run build",
    "prod-server": "npm --prefix server run build && npm --prefix server run start",
    "prod": "npm run prod-client && npm run prod-server",
    "dev-client": "npm --prefix client run dev",
    "dev-server": "npm --prefix server run dev",
    "dev": "node -e \"const {spawn}=require('child_process'); const o={shell:true,stdio:'inherit'}; spawn('npm --prefix server run dev', o); spawn('npm --prefix client run dev', o);\"",
    "start-dev": "node start.js dev",
    "start-prod": "node start.js prod",
    "start": "npm run start-prod"
  },
  "name": "sigmatokens",
